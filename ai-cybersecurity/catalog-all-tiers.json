            ],
            "parts": [
              {
                "id": "b.14.4_smt",
                "name": "statement",
                "prose": "The organisation has implemented relevant SDLC frameworks for AI, e.g.: – secure design; – secure development; – secure deployment; and – secure operations and maintenance."
              }
            ]
          },
          {
            "id": "b.14.6",
            "class": "clause",
