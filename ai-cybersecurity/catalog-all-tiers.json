              }
            ],
            "parts": [
              {
                "id": "b.4.5_smt",
                "name": "statement",
                "prose": "The cybersecurity strategy and roadmap has identified and documented the organisation’s objectives to guide the secure use of its AI system(s)."
              }
            ]
          },
          {
            "id": "b.4.9",
            "class": "clause",
            "title": "Cyber strategy – B.4.9 (Advocate)",
            "props": [
              {
                "name": "label",
                "value": "B.4.9"
              },
              {
                "name": "preparedness-tier",
                "value": "Advocate",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.4.9_smt",
                "name": "statement",
                "prose": "The organisation has also factored in the AI threat landscape, as organisations increasingly adopt AI."
              }
            ]
          }
        ]
      },
      {
        "id": "b.5",
        "class": "domain",
        "title": "Compliance",
        "props": [
          {
            "name": "label",
            "value": "B.5"
          }
        ],
        "controls": [
          {
            "id": "b.5.1",
            "class": "clause",
            "title": "Compliance – B.5.1 (Supporter)",
            "props": [
              {
                "name": "label",
                "value": "B.5.1"
              },
              {
                "name": "preparedness-tier",
                "value": "Supporter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.5.1_smt",
                "name": "statement",
                "prose": "In identifying the relevant laws, regulations and/or guidelines, the organisation has factored in the emerging landscape of AI regulations in the countries it operates in."
              }
            ]
          }
        ]
      },
      {
        "id": "b.8",
        "class": "domain",
        "title": "Asset management",
        "props": [
          {
            "name": "label",
            "value": "B.8"
          }
        ],
        "controls": [
          {
            "id": "b.8.3",
            "class": "clause",
            "title": "Asset management – B.8.3 (Promoter)",
            "props": [
              {
                "name": "label",
                "value": "B.8.3"
              },
              {
                "name": "preparedness-tier",
                "value": "Promoter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.8.3_smt",
                "name": "statement",
                "prose": "For classification and secure handling and deletion of the organisation’s data used for/in AI, the organisation has included its AI models and any training data used to train the AI models in its policies and procedures."
              }
            ]
          },
          {
            "id": "b.8.9",
            "class": "clause",
            "title": "Asset management – B.8.9 (Advocate)",
            "props": [
              {
                "name": "label",
                "value": "B.8.9"
              },
              {
                "name": "preparedness-tier",
                "value": "Advocate",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.8.9_smt",
                "name": "statement",
                "prose": "The organisation’s asset inventory management system has the capability to track and manage AI tools, services and/or systems."
              }
            ]
          }
        ]
      },
      {
        "id": "b.9",
        "class": "domain",
        "title": "Data protection and privacy",
        "props": [
          {
            "name": "label",
            "value": "B.9"
          }
        ],
        "controls": [
          {
            "id": "b.9.5",
            "class": "clause",
            "title": "Data protection and privacy – B.9.5 (Promoter)",
            "props": [
              {
                "name": "label",
                "value": "B.9.5"
              },
              {
                "name": "preparedness-tier",
                "value": "Promoter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.9.5_smt",
                "name": "statement",
                "prose": "The organisation has established and implemented classification and handling policies and procedures for employees to identify the data sets in the organisation that could be used in both internal and external AI tools and/or services, e.g. generative AI."
              }
            ]
          },
          {
            "id": "b.9.6",
            "class": "clause",
            "title": "Data protection and privacy – B.9.6 (Promoter)",
            "props": [
              {
                "name": "label",
                "value": "B.9.6"
              },
              {
                "name": "preparedness-tier",
                "value": "Promoter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.9.6_smt",
                "name": "statement",
                "prose": "The organisation’s data flow diagram for AI has included documentation of data associated with its AI system(s), e.g.: – data used for training AI system(s) (where relevant); – data input to AI system(s); including prompts, and – data output from AI system(s)."
              }
            ]
          },
          {
            "id": "b.9.7",
            "class": "clause",
            "title": "Data protection and privacy – B.9.7 (Promoter)",
            "props": [
              {
                "name": "label",
                "value": "B.9.7"
              },
              {
                "name": "preparedness-tier",
                "value": "Promoter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.9.7_smt",
                "name": "statement",
                "prose": "The organisation has implemented secure handling of: – data input to AI systems; – data models (where relevant); and – data output from AI systems. Examples of secure handling of data input to AI systems include measures for: – data integrity; – data provenance; – data validation and/or sanitisation; and – protection on the query interface to detect and mitigate attempts to access, modify and exfiltrate data, e.g. guardrails, rate limiting of queries. Examples of secure handling of AI models include measures for: – verification of models with hashes/ signatures; and – security evaluation of the AI systems before deployment, e.g. benchmarking, security testing, red teaming. Examples of secure handling of data output from AI systems include measures for: – verification of integrity of data output; and – generating output that is usable to users whilst not revealing unnecessary information to potential attackers."
              }
            ]
          },
          {
            "id": "b.9.10",
            "class": "clause",
            "title": "Data protection and privacy – B.9.10 (Advocate)",
            "props": [
              {
                "name": "label",
                "value": "B.9.10"
              },
              {
                "name": "preparedness-tier",
                "value": "Advocate",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.9.10_smt",
                "name": "statement",
                "prose": "For sensitive data, the organisation has considered the use of privacy-preserving techniques, e.g., anonymisation, differential privacy (where applicable) for data protection."
              }
            ]
          }
        ]
      },
      {
        "id": "b.12",
        "class": "domain",
        "title": "System security",
        "props": [
          {
            "name": "label",
            "value": "B.12"
          }
        ],
        "controls": [
          {
            "id": "b.12.4",
            "class": "clause",
            "title": "System security – B.12.4 (Promoter)",
            "props": [
              {
                "name": "label",
                "value": "B.12.4"
              },
              {
                "name": "preparedness-tier",
                "value": "Promoter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.12.4_smt",
                "name": "statement",
                "prose": "As part of secure configuration, the organisation has considered AI model complexity and the appropriateness of the model for the intended use case, as complex models may involve additional software packages or libraries, which expand the attack surface."
              }
            ]
          },
          {
            "id": "b.12.8",
            "class": "clause",
            "title": "System security – B.12.8 (Performer)",
            "props": [
              {
                "name": "label",
                "value": "B.12.8"
              },
              {
                "name": "preparedness-tier",
                "value": "Performer",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.12.8_smt",
                "name": "statement",
                "prose": "The organisation’s policies and procedures on secure configuration for AI have incorporated best practices. Examples include: – model hardening, e.g., through adversarial training; – prompt engineering best practices including use of guardrails; – monitoring and limiting the rate of queries to AI systems; or – use of ensembles of models for better resilience against attacks."
              }
            ]
          }
        ]
      },
      {
        "id": "b.13",
        "class": "domain",
        "title": "Virus and malware protection",
        "props": [
          {
            "name": "label",
            "value": "B.13"
          }
        ],
        "controls": [
          {
            "id": "b.13.8",
            "class": "clause",
            "title": "Virus and malware protection – B.13.8 (Advocate)",
            "props": [
              {
                "name": "label",
                "value": "B.13.8"
              },
              {
                "name": "preparedness-tier",
                "value": "Advocate",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "AI security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.13.8_smt",
                "name": "statement",
                "prose": "The organisation has established and implemented policies and processes to maintain visibility of AI-specific threats, including adversaries targeting AI, e.g., subscribing to threat intelligence which include AI-specific threats, participation in AI-related special interest groups or equivalent, to receive early warnings and advice regarding new threats and vulnerabilities."
              }
            ]
          }
        ]
      },
      {
