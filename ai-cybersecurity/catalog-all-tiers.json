            "parts": [
              {
                "id": "b.16.4_smt",
                "name": "statement",
                "prose": "The log monitoring policy, process and procedure have included: – monitoring inputs to the AI models or AI systems for possible attacks and suspicious activity; and – monitoring AI model or system outputs and performance."
              }
            ]
          },
          {
            "id": "b.16.11",
            "class": "clause",
            "title": "Cyber threat management – B.16.11 (Advocate)",
