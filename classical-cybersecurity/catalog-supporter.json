            "parts": [
              {
                "id": "b.7.1_smt",
                "name": "statement",
                "prose": "The organisation has implemented all the cybersecurity requirements in the mark of cyber hygiene, under “A.1 Assets: People”, to ensure that employees are equipped with the security knowledge and awareness to identify and mitigate against cyber threats."
              }
            ]
          }
        ]
      },
      {
