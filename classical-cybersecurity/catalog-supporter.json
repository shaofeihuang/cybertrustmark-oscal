              {
                "id": "b.5.1_smt",
                "name": "statement",
                "prose": "The organisation has identified the cybersecurity-related laws, regulations and/or guidelines (e.g., sector-specific) applicable in its area of business in order to comply with them."
              }
            ]
          }
        ]
      },
      {
