      {
        "id": "b.3",
        "class": "domain",
        "title": "Risk management",
        "props": [
          {
            "name": "label",
            "value": "B.3"
          }
        ],
        "controls": [
          {
            "id": "b.3.1",
            "class": "clause",
            "title": "Risk management – B.3.1 (Supporter)",
            "props": [
              {
                "name": "label",
                "value": "B.3.1"
              },
              {
                "name": "preparedness-tier",
                "value": "Supporter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Classical cybersecurity",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.3.1_smt",
                "name": "statement",
                "prose": "The organisation has identified the cybersecurity risks in the environment, including risks on-premises, and where applicable, remote risks, to ensure that all the identified cybersecurity risks can be addressed."
              }
            ]
          },
          {
            "id": "b.3.2",
            "class": "clause",
            "title": "Risk management – B.3.2 (Supporter)",
            "props": [
              {
                "name": "label",
                "value": "B.3.2"
              },
              {
                "name": "preparedness-tier",
                "value": "Supporter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Classical cybersecurity",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.3.2_smt",
                "name": "statement",
                "prose": "The organisation performs steps to analyse and prioritise the critical cybersecurity risks in its business environment to ensure that the more critical cybersecurity risks are addressed first."
              }
            ]
          }
        ]
      },
      {
