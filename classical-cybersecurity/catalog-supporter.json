              {
                "id": "b.8.1_smt",
                "name": "statement",
                "prose": "The organisation has implemented all the cybersecurity requirements in the mark of cyber hygiene under A.2 Assets: Hardware and software to ensure that hardware and software present in the environment are identified and protected against common cyber threats."
              }
            ]
          }
        ]
      },
      {
        "id": "b.9",
        "class": "domain",
        "title": "Data protection and privacy",
        "props": [
          {
            "name": "label",
            "value": "B.9"
          }
        ],
        "controls": [
          {
            "id": "b.9.1",
            "class": "clause",
            "title": "Data protection and privacy – B.9.1 (Supporter)",
            "props": [
              {
                "name": "label",
                "value": "B.9.1"
              },
              {
                "name": "preparedness-tier",
                "value": "Supporter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Classical cybersecurity",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.9.1_smt",
                "name": "statement",
                "prose": "The organisation has implemented all the cybersecurity requirements in the mark of cyber hygiene under “A.3 Assets: Data” to ensure that business-critical data (including personal data, company secrets, intellectual property) can be identified, located and secured."
              }
            ]
          },
          {
            "id": "b.9.2",
            "class": "clause",
            "title": "Data protection and privacy – B.9.2 (Supporter)",
            "props": [
              {
                "name": "label",
                "value": "B.9.2"
              },
              {
                "name": "preparedness-tier",
                "value": "Supporter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Classical cybersecurity",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.9.2_smt",
                "name": "statement",
                "prose": "The organisation has defined and applied a process to report any business-critical data (including personal data, company secrets, intellectual property) breach and to ensure that stakeholders such as the management, relevant authorities and relevant individuals are kept informed."
              }
            ]
          },
          {
            "id": "b.9.3",
            "class": "clause",
            "title": "Data protection and privacy – B.9.3 (Supporter)",
            "props": [
              {
                "name": "label",
                "value": "B.9.3"
              },
              {
                "name": "preparedness-tier",
                "value": "Supporter",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Classical cybersecurity",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.9.3_smt",
                "name": "statement",
                "prose": "The organisation using encryption has defined and applied a process on the use of recommended protocol and algorithm and minimum key length to ensure that it is secure and in alignment to industry best practices."
              }
            ]
          }
        ]
      },
