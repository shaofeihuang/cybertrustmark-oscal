      {
        "id": "b.13",
        "class": "domain",
        "title": "Virus and malware protection",
        "props": [
          {
            "name": "label",
            "value": "B.13"
          }
        ],
        "controls": [
          {
            "id": "b.13.3",
            "class": "clause",
            "title": "Virus and malware protection – B.13.3 (Practitioner)",
            "props": [
              {
                "name": "label",
                "value": "B.13.3"
              },
              {
                "name": "preparedness-tier",
                "value": "Practitioner",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Cloud security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.13.3_smt",
                "name": "statement",
                "prose": "The organisation has implemented the appropriate virus and malware protection based on the cloud shared responsibility model with its CSP. In situations where the CSP is responsible, the organisation has reviewed the virus and malware protection practices of its CSPs, to ensure the implementation is in alignment with its organisational policies."
              }
            ]
          },
          {
            "id": "b.13.5",
            "class": "clause",
            "title": "Virus and malware protection – B.13.5 (Practitioner)",
            "props": [
              {
                "name": "label",
                "value": "B.13.5"
              },
              {
                "name": "preparedness-tier",
                "value": "Practitioner",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Cloud security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.13.5_smt",
                "name": "statement",
                "prose": "The organisation has developed a process for the removal of malware that has been detected in the organisation’s cloud environment, in accordance with applicable contractual agreements with its CSPs and its own organisational policies."
              }
            ]
          }
        ]
      },
      {
        "id": "b.19",
        "class": "domain",
        "title": "Physical/environmental security",
        "props": [
          {
            "name": "label",
            "value": "B.19"
          }
        ],
        "controls": [
          {
            "id": "b.19.4",
            "class": "clause",
            "title": "Physical/environmental security – B.19.4 (Practitioner)",
            "props": [
              {
                "name": "label",
                "value": "B.19.4"
              },
              {
                "name": "preparedness-tier",
                "value": "Practitioner",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Cloud security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.19.4_smt",
                "name": "statement",
                "prose": "The organisation has verified that the physical security measures implemented by its CSPs, e.g., providers' statements on physical security controls, including their data centres, certification(s) of recognised and appropriate standards that cover physical security, are in alignment with its requirements."
              }
            ]
          }
        ]
      },
      {
        "id": "b.20",
        "class": "domain",
        "title": "Network security",
        "props": [
          {
            "name": "label",
            "value": "B.20"
          }
        ],
        "controls": [
          {
            "id": "b.20.3",
            "class": "clause",
            "title": "Network security – B.20.3 (Practitioner)",
            "props": [
              {
                "name": "label",
                "value": "B.20.3"
              },
              {
                "name": "preparedness-tier",
                "value": "Practitioner",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              },
              {
                "name": "security-context",
                "value": "Cloud security",
                "ns": "https://www.csa.gov.sg/cyber-trust"
              }
            ],
            "parts": [
              {
                "id": "b.20.3_smt",
                "name": "statement",
                "prose": "Examples include measures such as: – implementing runtime protection for containers or virtual machines, e.g., network segmentation for containers or virtual machines; and – using container firewalls or virtual firewalls to manage network traffic flow."
              }
            ]
          }
        ]
      }
