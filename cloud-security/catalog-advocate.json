        "class": "domain",
        "title": "Cyber threat management",
        "props": [
          {
            "name": "label",
            "value": "B.16"
          }
        ],
        "controls": [
          {
            "id": "b.16.11",
            "class": "clause",
            "title": "Cyber threat management – B.16.11 (Advocate)",
            "props": [
              {
                "name": "label",
